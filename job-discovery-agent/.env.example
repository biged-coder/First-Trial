# Job Discovery & Verification Agent - credential placeholders
#
# This workflow runs inside n8n and uses n8n Credentials (not process env vars)
# for every external service. This file documents what to configure and where,
# so the mapping is easy to check even though n8n does not read .env directly.

# --- Apify -----------------------------------------------------------------
# Used by the "Run Apify Actor (sync)" HTTP Request node.
# n8n credential: Header Auth (httpHeaderAuth), named "Apify" in this workflow.
# Header should send: Authorization: Bearer <APIFY_TOKEN>
APIFY_TOKEN=your_apify_api_token_here

# Apify actor to run. Set this in the "Config" node (apifyActorId field), not env.
# Default: curious_coder~linkedin-jobs-scraper (pay-per-event pricing, ~$0.001-0.002
# per result -- runs on Apify's $5/month free platform credit at low volumes, no
# rental required). The originally-planned bebity~linkedin-jobs-scraper actor
# requires renting a paid plan even to run its free trial period.
APIFY_ACTOR_ID=curious_coder~linkedin-jobs-scraper

# --- Exa Search --------------------------------------------------------------
# Used by the "Exa Verify Search" HTTP Request node.
# n8n credential: Header Auth (httpHeaderAuth), named "Exa Search" in this workflow.
# Header should send: x-api-key: <EXA_API_KEY>
EXA_API_KEY=your_exa_api_key_here

# --- LLM for the AI Agent nodes ----------------------------------------------
# This workflow defaults to DeepSeek (credential "DeepSeek account", deepSeekApi).
# To use Anthropic or OpenAI instead, swap the "DeepSeek Model (Taxonomy)" and
# "DeepSeek Model (Research)" nodes for the equivalent Chat Model node and set
# the matching key below.
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# --- Google Sheets -------------------------------------------------------------
# Used by all "...to Sheet" / "Upsert Job Pipeline Row" nodes.
# n8n credential: Google Service Account (googleApi), named
# "Google Service Account account" in this workflow.
# Requires a service account JSON key with Sheets API access, shared on the
# target spreadsheet as an Editor.
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Spreadsheet to write results to. Select it in the n8n UI on the
# "Upsert Job Pipeline Row", "Log Unverified Listing" and "Log ... Error to
# Sheet" nodes (Document dropdown) - it is left as a placeholder in the
# workflow since the ID is specific to your Google Drive.
# Required tabs: "Job Pipeline", "Unverified", "Error Log"
JOB_PIPELINE_SPREADSHEET_ID=your_google_sheet_id_here

# Optional fallback search API (not wired into the workflow by default; only
# needed if you want to add a redundant verification path).
# TAVILY_API_KEY=your_tavily_api_key_here
